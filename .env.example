# Copy file ini jadi `.env` (di folder yang sama) lalu isi/sesuaikan nilainya.

# ---------- License-check ----------
# WAJIB DIISI -- kalau kosong, program NOLAK JALAN (fail-closed, tidak ada
# mode bypass). Reuse LICENSE_DEVICE_TOKEN yang sama dengan searchhost utama/
# checker/wp-check kalau dijalankan di PC yang sama dan .env root searchhost
# sudah terisi -- kalau tidak, minta token sendiri ke admin.
LICENSE_CHECK_URL=https://example.com/monday/searchhost/lisensi-server/api/license-check
LICENSE_DEVICE_TOKEN=<token-device-dari-admin>
LICENSE_CHECK_TIMEOUT_SECONDS=5

# ---------- Sistem API Skema & Data (opsional) ----------
# Kalau diisi, tiap baris data.txt (SUCCESS dan SSIAPA) diupload realtime ke
# Sistem API "Skema & Data", masing-masing skema punya API key sendiri.
# Kosongkan salah satu/keduanya buat skip upload skema itu -- data.txt lokal
# tetap tersimpan seperti biasa apa pun kondisinya.
SCHEMA_DATA_BASE_URL=https://example.com/monday/mr4sepgood
SCHEMA_DATA_API_KEY_SS=<key-skema-SS>
SCHEMA_DATA_API_KEY_SSIAPA=<key-skema-SSIAPA>

# ---------- Remote bucket: target host (opsional) ----------
# Kalau diisi, auto-klaim file dari bucket API tiap siklus (paralel sampai
# bucket kosong), lalu di-APPEND ke logs/host_formatted.txt. Terima 2 format
# isi (boleh campur): baris "domain -> url" dibiarkan apa adanya, baris URL
# polos (gaya list-hosting.txt) domain-nya diekstrak otomatis. Baris yang
# persis sama dengan yang sudah ada otomatis di-skip (tidak dobel).
# Kosongkan buat tetap pakai host_formatted.txt lokal.
DATAHOST_REMOTE_FILES_BASE_URL=https://example.com/monday/mr4sepgood/api/files.php
DATAHOST_REMOTE_FILES_API_KEY=<key-bucket-datahost>

# ---------- Remote bucket: kredensial (opsional) ----------
# BUCKET TERPISAH dari bucket target host di atas -- isinya "url|user|pass"
# per baris, disimpan ke data-folder/<label file di bucket>. Label file di
# bucket WAJIB mengandung nama domain yang sesuai.
DATAHOST_CREDS_REMOTE_FILES_BASE_URL=https://example.com/monday/mr4sepgood/api/files.php
DATAHOST_CREDS_REMOTE_FILES_API_KEY=<key-bucket-kredensial>
